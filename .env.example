# URL base do projeto Supabase.
SUPABASE_URL=https://your-project.supabase.co

# Chave pública anon do Supabase (exemplo não funcional).
SUPABASE_ANON_KEY=your-supabase-anon-key

# Emissor dos tokens JWT do Supabase.
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1

# JSON de origens permitidas. Configure explicitamente para o frontend.
CORS_ORIGINS=["http://localhost:3000"]

# Valores documentados, sujeitos à confirmação do regulamento pelo P.O.
MINIMUM_ATTENDANCE=75
MINIMUM_GRADE=6
JWKS_CACHE_SECONDS=300
JWKS_TIMEOUT_SECONDS=5

# Limite provisório decimal de 10 MB; confirmar com o P.O. e Caio.
ATTACHMENT_MAX_BYTES=10000000
