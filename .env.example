# URL base do projeto Supabase.
SUPABASE_URL=https://your-project.supabase.co

# Chave pública anon do Supabase (exemplo não funcional).
SUPABASE_ANON_KEY=

# Alternativa pública moderna à chave anon; use uma das duas.
# SUPABASE_PUBLISHABLE_KEY=

# Emissor dos tokens JWT do Supabase.
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1

# JSON de origens permitidas para o frontend local. Adapte na implantação.
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Valores documentados, sujeitos à confirmação do regulamento pelo P.O.
MINIMUM_ATTENDANCE=75
MINIMUM_GRADE=6
JWKS_CACHE_SECONDS=300
JWKS_TIMEOUT_SECONDS=5

# Limite confirmado do bucket privado: 10 MiB.
ATTACHMENT_MAX_BYTES=10485760
